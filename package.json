{
  "name": "ttb-label-verifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted TTB alcohol beverage label verification prototype",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/verify.test.js",
    "samples": "node scripts/generate-samples.js",
    "build:artifact": "node scripts/build-artifact.js",
    "smoke": "node scripts/build-artifact.js && node scripts/smoke-test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
