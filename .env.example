# Required for the server build.
ANTHROPIC_API_KEY=

# Optional. The default is chosen for latency (the five-second target).
# TTB_MODEL=claude-haiku-4-5-20251001

# PORT=3000

# Cost guards for a public deployment (both off when unset).
# ACCESS_CODE: reviewers open https://your-app/?code=THIS-VALUE
# ACCESS_CODE=
# DAILY_LABEL_LIMIT: max labels checked per UTC day across all users.
# DAILY_LABEL_LIMIT=200
